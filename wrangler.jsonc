{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pryzael",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node scripts/generate_mcp_catalog.mjs && node --test worker/index.test.mjs",
    "watch_dir": [
      "skills",
      "scripts/generate_mcp_catalog.mjs",
      "worker/index.mjs",
      "worker/index.test.mjs"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0,
      "persist": false
    }
  }
}
