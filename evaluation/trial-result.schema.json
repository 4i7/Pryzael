{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4i7/Pryzael/evaluation/trial-result.schema.json",
  "title": "Pryzael R4 TrialResult v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["trial_id","trial_index","evaluation_identity","task","condition","artifact_identity","activation","observable_environment","predicate_observations","metric_observations","judge","result","limitations"],
  "properties": {
    "trial_id": {"type":"string","minLength":1},
    "trial_index": {"type":"integer","minimum":1},
    "evaluation_identity": {
      "type":"object","additionalProperties":false,
      "required":["contract_id","contract_sha256","public_manifest_id","public_manifest_sha256","qualification_set_id","qualification_commitment_sha256","packet_sha256","protocol_revision","task_digest"],
      "properties": {
        "contract_id":{"type":"string","minLength":1},"contract_sha256":{"type":"string","minLength":1},"public_manifest_id":{"type":"string","minLength":1},"public_manifest_sha256":{"type":"string","minLength":1},"qualification_set_id":{"type":"string","minLength":1},"qualification_commitment_sha256":{"type":"string","minLength":1},"packet_sha256":{"type":"string","minLength":1},"protocol_revision":{"type":"string","minLength":1},"task_digest":{"type":"string","minLength":1}
      }
    },
    "task": {"type":"object","additionalProperties":false,"required":["task_id","family","partition"],"properties":{"task_id":{"type":"string","minLength":1},"family":{"type":"string","minLength":1},"partition":{"enum":["DEVELOPMENT","QUALIFICATION","ROUTING","CALIBRATION"]}}},
    "condition": {"enum":["NO_PRYZAEL","CURRENT_PRYZAEL","CANDIDATE_PRYZAEL"]},
    "artifact_identity": {"type":"object","additionalProperties":false,"required":["repository","source_commit_sha","source_tree_sha","plugin_version","canonical_skill_tree_sha","skill_package_identity"],"properties":{"repository":{"type":"string","minLength":1},"source_commit_sha":{"type":"string","minLength":1},"source_tree_sha":{"type":"string","minLength":1},"plugin_version":{"type":"string","minLength":1},"canonical_skill_tree_sha":{"type":"string","minLength":1},"skill_package_identity":{"type":"string","minLength":1}}},
    "activation": {"type":"object","additionalProperties":false,"required":["mode","surface"],"properties":{"mode":{"enum":["CONDITIONED_BEHAVIOR","NATIVE_AUTOMATIC_SKILL_SELECTION","MCP_AUTOMATIC_TOOL_SELECTION","FORCED_INVOCATION_CALIBRATION"]},"surface":{"enum":["NATIVE","MCP","NONE"]}}},
    "observable_environment": {
      "type":"object","additionalProperties":false,
      "required":["host_product_surface","model_identity","model_configuration","observer_revision","transport","timestamp","ordinary_tool_availability","product_version","authority_envelope_id","trial_protocol_budget_id","pryzael_assistance"],
      "properties":{"host_product_surface":{"type":"string","minLength":1},"model_identity":{"type":"string","minLength":1},"model_configuration":{"type":"string","minLength":1},"observer_revision":{"type":"string","minLength":1},"transport":{"type":"string","minLength":1},"timestamp":{"type":"string","minLength":1},"product_version":{"type":"string","minLength":1},"authority_envelope_id":{"type":"string","minLength":1},"trial_protocol_budget_id":{"type":"string","minLength":1},"ordinary_tool_availability":{"oneOf":[{"type":"array","items":{"type":"string"}},{"const":"UNKNOWN"}]},"pryzael_assistance":{"enum":["ABSENT","CURRENT","CANDIDATE","UNKNOWN"]}}
    },
    "predicate_observations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["predicate_id","predicate_role","result","applicability","evidence_refs"],"properties":{"predicate_id":{"type":"string","minLength":1},"predicate_role":{"enum":["SUCCESS","CRITICAL"]},"result":{"enum":["VERIFIED","NOT_VERIFIED","INCONCLUSIVE"]},"applicability":{"enum":["APPLICABLE","NOT_APPLICABLE"]},"evidence_refs":{"type":"array","items":{"type":"string"}}}}},
    "metric_observations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["metric_id","value","evidence_refs"],"properties":{"metric_id":{"type":"string","minLength":1},"value":{"oneOf":[{"type":"string"},{"type":"integer","minimum":0},{"type":"number","minimum":0}]},"evidence_refs":{"type":"array","items":{"type":"string"}}}}},
    "replanning_observation": {"type":"object","additionalProperties":false,"required":["prior_plan_or_assumption","new_evidence","material_invalidation","observed_response","judge_result"],"properties":{"prior_plan_or_assumption":{"type":"string","minLength":1},"new_evidence":{"type":"string","minLength":1},"material_invalidation":{"enum":["YES","NO","INCONCLUSIVE"]},"observed_response":{"type":"string","minLength":1},"judge_result":{"enum":["APPROPRIATE_REPLAN","FAILED_TO_REPLAN","UNJUSTIFIED_PLAN_CHURN","INCONCLUSIVE"]}}},
    "judge": {"type":"object","additionalProperties":false,"required":["identity","configuration","blinded_label"],"properties":{"identity":{"type":"string","minLength":1},"configuration":{"type":"string","minLength":1},"blinded_label":{"type":"string","minLength":1}}},
    "result": {"enum":["TASK_SUCCESS","PARTIAL_SUCCESS","CRITICAL_ERROR","INCONCLUSIVE"]},
    "limitations": {"type":"array","items":{"type":"string"}}
  }
}
